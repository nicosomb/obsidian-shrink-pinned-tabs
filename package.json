{
	"name": "shrink-pinned-tabs",
	"version": "1.2.0",
	"description": "Obsidian plugin to shrink pinned tabs in order to save screen space",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint . --max-warnings 0",
		"test": "node --test tests/*.test.mjs",
		"check": "npm run lint && npm run lint:css && npm test && npm run build && node scripts/check-release.mjs",
		"lint:css": "stylelint styles.css --max-warnings 0",
		"test:browser": "playwright test"
	},
	"keywords": [],
	"author": "Nicolas L\u0153uillet",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.63.0",
		"@types/node": "24.19.0",
		"esbuild": "0.28.2",
		"eslint": "10.11.0",
		"eslint-plugin-obsidianmd": "0.4.2",
		"globals": "17.12.0",
		"jsdom": "30.1.1",
		"obsidian": "1.13.1",
		"stylelint": "17.15.0",
		"stylelint-config-obsidianmd": "0.1.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.70.1"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"overrides": {
		"eslint-plugin-obsidianmd": {
			"@eslint/js": "$@eslint/js",
			"obsidian": "$obsidian"
		}
	}
}
